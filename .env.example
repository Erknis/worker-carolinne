# ============================================================
# Worker Carolinne — exemplo de variáveis (NUNCA coloque segredos reais aqui)
# Copie para .env e preencha, ou use os secrets do EasyPanel.
# ============================================================

# Autenticação da API do worker — use uma chave forte e aleatória (32+ caracteres).
CAROLINNE_WORKER_API_KEY=TROQUE_POR_UMA_CHAVE_FORTE_ALEATORIA
BOT_NAME=Carolinne
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO

# Redis para salvar clientes/histórico/estado/rate-limit.
REDIS_URL=redis://default:SUA_SENHA_DO_REDIS@host_redis:6379/0

# Atendimento
PIX_KEY=03186401046
PAYMENT_SITE_URL=

# Evolution API (envio direto, bypass de n8n)
EVOLUTION_API_URL=http://host_evolution-api:8080
EVOLUTION_API_KEY=SUA_CHAVE_DA_EVOLUTION_API
EVOLUTION_INSTANCE_NAME=liberoutv
EMILIANO_PHONE=555592017793

# Agente via API: coloque sua chave para resposta por IA.
# Suporta Anthropic (Claude) e OpenAI. Sem chave, o worker usa fallback de regras.
AGENT_MODE=hybrid
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=18
LLM_MAX_TOKENS=300

# Multi-mensagens (pausa entre balões em segundos)
MSG_DELAY_SECONDS=1.5

# Rate limiting (mensagens por número na janela)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=3600

# Supabase — banco permanente de clientes e handoffs
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CLIENTS_TABLE=clientes
SUPABASE_PHONE_COLUMN=whatsapp
SUPABASE_HANDOFFS_TABLE=handoffs
